{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "Post",
        "grounded": true
      },
      "bind": {
        "$left": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 10,
        "width": 10,
        "height": 20,
        "operation": "new",
        "corner": [
          -20.0,
          -5.0,
          0.0
        ],
        "body_name": "Post"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.copy",
      "params": {
        "component": "Post",
        "translate": [
          30.0,
          0.0,
          0.0
        ]
      },
      "bind": {
        "$right": "occurrence"
      }
    }
  ]
}
