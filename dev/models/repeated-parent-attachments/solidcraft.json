{
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "expression": "40",
        "name": "parent_height",
        "unit": "mm"
      }
    },
    {
      "bind": {
        "$parent_occurrence_1": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Parent"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Parent",
        "corner": [
          -10.0,
          -10.0,
          0
        ],
        "height": "parent_height",
        "length": 20,
        "width": 20
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$parent_occurrence_2": "occurrence"
      },
      "command": "occurrence.copy",
      "params": {
        "component": "Parent",
        "translate": [
          60.0,
          0.0,
          0.0
        ]
      }
    },
    {
      "bind": {
        "$marker_occurrence_1": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": false,
        "name": "Marker"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Marker",
        "corner": [
          -5.0,
          -5.0,
          0
        ],
        "height": 10,
        "length": 10,
        "width": 10
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$marker_occurrence_2": "occurrence"
      },
      "command": "occurrence.copy",
      "params": {
        "component": "Marker"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$marker_occurrence_1",
        "translate": [
          0,
          0,
          "parent_height"
        ]
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$marker_occurrence_2",
        "translate": [
          60,
          0,
          "parent_height"
        ]
      }
    },
    {
      "command": "joint.create",
      "params": {
        "a": {
          "face": [
            0.0,
            0.0,
            40.0
          ],
          "occurrence": "$parent_occurrence_1"
        },
        "b": {
          "face": [
            0.0,
            0.0,
            40.0
          ],
          "occurrence": "$marker_occurrence_1"
        },
        "name": "Attach Marker occurrence 1 to Parent occurrence 1",
        "type": "rigid"
      }
    },
    {
      "command": "joint.create",
      "params": {
        "a": {
          "face": [
            60.0,
            0.0,
            40.0
          ],
          "occurrence": "$parent_occurrence_2"
        },
        "b": {
          "face": [
            60.0,
            0.0,
            40.0
          ],
          "occurrence": "$marker_occurrence_2"
        },
        "name": "Attach Marker occurrence 2 to Parent occurrence 2",
        "type": "rigid"
      }
    },
    {
      "command": "browser.visibility",
      "params": {
        "folder": "joints",
        "visible": false
      }
    }
  ],
  "format": "scpf-replay",
  "version": 2
}
