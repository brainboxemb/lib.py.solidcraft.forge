{
  "commands": [
    {
      "bind": {
        "$base": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Base"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Base",
        "corner": [
          -20.0,
          -15.0,
          0
        ],
        "height": 10,
        "length": 40,
        "width": 30
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$block": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": false,
        "name": "Block"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Block",
        "corner": [
          -10.0,
          -10.0,
          0
        ],
        "height": 10,
        "length": 20,
        "width": 20
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "expression": "10 mm",
        "name": "gap"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block",
        "translate": [
          "(gap + 20 mm) - -10 mm",
          0,
          0.0
        ]
      }
    },
    {
      "command": "joint.create",
      "params": {
        "a": {
          "face": [
            20.0,
            0.0,
            5.0
          ],
          "occurrence": "$base"
        },
        "b": {
          "face": [
            30.0,
            0.0,
            5.0
          ],
          "occurrence": "$block"
        },
        "name": "Attach Block to Base",
        "offset": "gap",
        "type": "rigid"
      }
    },
    {
      "command": "browser.visibility",
      "params": {
        "folder": "joints",
        "visible": false
      }
    }
  ],
  "format": "scpf-replay",
  "version": 2
}
