{
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "sleeve_height",
        "expression": "30",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "fit_diameter",
        "expression": "19.8",
        "unit": "mm"
      }
    },
    {
      "command": "component.create",
      "params": {
        "name": "FlexibleSleeve",
        "grounded": true
      }
    },
    {
      "command": "solid.cylinder",
      "params": {
        "height": "sleeve_height",
        "diameter": "fit_diameter",
        "base": [
          0,
          0,
          "-(sleeve_height / 2)"
        ],
        "axis": "Z",
        "operation": "new",
        "body_name": "FlexibleSleeve"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 12,
        "width": 2.0,
        "height": "sleeve_height + 2 mm",
        "operation": "cut",
        "center": [
          6.0,
          0.0,
          0.0
        ],
        "targets": [
          "FlexibleSleeve"
        ]
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "config.configure",
      "params": {
        "params": [
          "sleeve_height",
          "fit_diameter"
        ]
      }
    },
    {
      "command": "config.row",
      "params": {
        "name": "Default",
        "rename": "Small"
      }
    },
    {
      "command": "config.row",
      "params": {
        "name": "Small",
        "values": {
          "param:sleeve_height": "20 mm",
          "param:fit_diameter": "19.8 mm"
        }
      }
    },
    {
      "command": "config.row",
      "params": {
        "name": "Medium",
        "values": {
          "param:sleeve_height": "30 mm",
          "param:fit_diameter": "19.8 mm"
        }
      }
    },
    {
      "command": "config.row",
      "params": {
        "name": "Large",
        "values": {
          "param:sleeve_height": "40 mm",
          "param:fit_diameter": "19.8 mm"
        }
      }
    }
  ]
}
