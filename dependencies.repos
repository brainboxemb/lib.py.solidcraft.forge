# Exact external repository tools used by Forge CI.
# tool.cad.ci stays a checked-out repository tool under ext/cad-ci. Forge itself
# remains installed from scpf/ as the Python library under test.
repositories:
  cad-ci:
    type: git
    url: https://github.com/brainboxemb/tool.cad.ci.git
    version: f43e13d7e1547e4caef9827848bace4744d30e17
