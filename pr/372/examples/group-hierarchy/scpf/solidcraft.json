{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "PanelGroup",
        "activate": false,
        "grounded": false
      }
    },
    {
      "command": "component.create",
      "params": {
        "name": "Panel",
        "grounded": true,
        "parent": "PanelGroup"
      },
      "bind": {
        "$panel_occurrence_1": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 10,
        "width": 2,
        "height": 20,
        "corner": [
          -5.0,
          -1.0,
          0
        ],
        "body_name": "Panel"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.copy",
      "params": {
        "component": "Panel",
        "translate": [
          11.0,
          0.0,
          0.0
        ]
      },
      "bind": {
        "$panel_occurrence_2": "occurrence"
      }
    },
    {
      "command": "component.create",
      "params": {
        "name": "Frame",
        "grounded": false
      },
      "bind": {
        "$frame": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 35,
        "width": 10,
        "height": 40,
        "operation": "new",
        "corner": [
          -17.5,
          15.0,
          0.0
        ],
        "body_name": "Frame"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    }
  ]
}
