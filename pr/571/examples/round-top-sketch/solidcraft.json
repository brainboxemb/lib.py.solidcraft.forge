{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "sketch.create",
      "params": {
        "plane": "XY",
        "name": "Disc"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0,
          0
        ],
        "diameter": 100
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "distance": 10,
        "direction": "positive",
        "body_name": "RoundTopSketch"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "RoundTopSketch"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "RoundTopSketch",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Hub"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          0.0,
          0.0
        ],
        "diameter": 44
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "join",
        "targets": [
          "RoundTopSketch"
        ],
        "name": "Hub",
        "distance": 16,
        "direction": "positive"
      }
    }
  ]
}
