{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "hole_diameter",
        "expression": "8",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "hole_columns",
        "expression": "4",
        "unit": ""
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "hole_pitch",
        "expression": "25",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "slot_count",
        "expression": "2",
        "unit": ""
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "slot_pitch",
        "expression": "50",
        "unit": "mm"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 240,
        "width": 160,
        "height": 5,
        "corner": [
          -120.0,
          -80.0,
          0
        ],
        "body_name": "SketchPatternMirror"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "SketchPatternMirror"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "SketchPatternMirror",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Dog holes"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          -60.0,
          -45.0
        ],
        "diameter": "hole_diameter"
      },
      "bind": {
        "$sketch_1_profile_1": "curves"
      }
    },
    {
      "command": "sketch.pattern.rectangular",
      "params": {
        "entities": "$sketch_1_profile_1",
        "count": "hole_columns",
        "spacing": "hole_pitch",
        "dir": [
          1.0,
          0.0
        ]
      },
      "bind": {
        "$sketch_1_operation_1": {
          "field": "curves",
          "prepend": "$sketch_1_profile_1"
        }
      }
    },
    {
      "command": "sketch.mirror",
      "params": {
        "entities": "$sketch_1_operation_1",
        "line": "x"
      },
      "bind": {
        "$sketch_1_operation_2": "curves"
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "SketchPatternMirror"
        ],
        "name": "Dog holes",
        "through_all": true,
        "direction": "negative"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "SketchPatternMirror"
      },
      "bind": {
        "$face_point_2": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_2": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_2",
          "body": "SketchPatternMirror",
          "index": "$face_index_2"
        },
        "project_edges": false,
        "name": "Clamp slots"
      }
    },
    {
      "command": "sketch.slot.center_to_center",
      "params": {
        "p0": [
          20.0,
          20.0
        ],
        "p1": [
          40.0,
          20.0
        ],
        "width": 8.0
      },
      "bind": {
        "$sketch_2_profile_1": "curves"
      }
    },
    {
      "command": "sketch.pattern.rectangular",
      "params": {
        "entities": "$sketch_2_profile_1",
        "count": "slot_count",
        "spacing": "slot_pitch",
        "dir": [
          1.0,
          0.0
        ]
      },
      "bind": {
        "$sketch_2_operation_1": {
          "field": "curves",
          "prepend": "$sketch_2_profile_1"
        }
      }
    },
    {
      "command": "sketch.mirror",
      "params": {
        "entities": "$sketch_2_operation_1",
        "line": "y"
      },
      "bind": {
        "$sketch_2_operation_2": "curves"
      }
    },
    {
      "command": "sketch.mirror",
      "params": {
        "entities": "$sketch_2_operation_1",
        "line": "x"
      },
      "bind": {
        "$sketch_2_operation_3": "curves"
      }
    },
    {
      "command": "sketch.mirror",
      "params": {
        "entities": "$sketch_2_operation_2",
        "line": "x"
      },
      "bind": {
        "$sketch_2_operation_4": "curves"
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "SketchPatternMirror"
        ],
        "name": "Clamp slots",
        "through_all": true,
        "direction": "negative"
      }
    }
  ]
}
