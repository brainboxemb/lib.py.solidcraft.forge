{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "pcd",
        "expression": "60",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "bolts",
        "expression": "6",
        "unit": ""
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 100,
        "width": 100,
        "height": 6,
        "corner": [
          -50.0,
          -50.0,
          0
        ],
        "body_name": "CircularFeaturePattern"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "CircularFeaturePattern"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "CircularFeaturePattern",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "BoltHole"
      }
    },
    {
      "command": "sketch.circle.center",
      "params": {
        "center": [
          "(pcd / 2)",
          0.0
        ],
        "diameter": 8
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "CircularFeaturePattern"
        ],
        "name": "BoltHole",
        "through_all": true,
        "direction": "negative"
      }
    },
    {
      "command": "solid.pattern.circular",
      "params": {
        "features": [
          "BoltHole"
        ],
        "axis": "Z",
        "count": "bolts",
        "alignment": "right",
        "reversed": false
      }
    }
  ]
}
