{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "base_width",
        "expression": "80",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "base_depth",
        "expression": "60",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "base_height",
        "expression": "5",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "pad_width",
        "expression": "40",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "pad_depth",
        "expression": "30",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "radius",
        "expression": "5",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "pad_height",
        "expression": "8",
        "unit": "mm"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": "base_width",
        "width": "base_depth",
        "height": "base_height",
        "corner": [
          "-base_width / 2",
          "-base_depth / 2",
          0
        ],
        "body_name": "RoundedRectangleSketch"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "RoundedRectangleSketch"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "RoundedRectangleSketch",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Rounded pad"
      }
    },
    {
      "command": "sketch.rectangle.rounded",
      "params": {
        "p0": [
          "(-(pad_width / 2))",
          "(-(pad_depth / 2))"
        ],
        "p1": [
          "(pad_width / 2)",
          "(pad_depth / 2)"
        ],
        "radius": "radius"
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "join",
        "targets": [
          "RoundedRectangleSketch"
        ],
        "name": "Rounded pad",
        "distance": "pad_height",
        "direction": "positive"
      }
    }
  ]
}
