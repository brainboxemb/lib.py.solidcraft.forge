{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "Base",
        "grounded": true
      },
      "bind": {
        "$base": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 40,
        "width": 30,
        "height": 10,
        "corner": [
          -20.0,
          -15.0,
          0
        ],
        "body_name": "Base"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "component.create",
      "params": {
        "name": "Block",
        "grounded": false
      },
      "bind": {
        "$block": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 20,
        "width": 20,
        "height": 10,
        "corner": [
          -10.0,
          -10.0,
          0
        ],
        "body_name": "Block"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "gap",
        "expression": "10 mm"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block",
        "translate": [
          "(gap + 20 mm) - -10 mm",
          0,
          0.0
        ]
      }
    },
    {
      "command": "joint.create",
      "params": {
        "type": "rigid",
        "name": "Attach Block to Base",
        "a": {
          "face": [
            20.0,
            0.0,
            5.0
          ],
          "occurrence": "$base"
        },
        "b": {
          "face": [
            30.0,
            0.0,
            5.0
          ],
          "occurrence": "$block"
        },
        "offset": "gap"
      }
    },
    {
      "command": "browser.visibility",
      "params": {
        "folder": "joints",
        "visible": false
      }
    }
  ]
}
