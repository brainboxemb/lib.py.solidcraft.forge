{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "name": "columns",
        "expression": "3",
        "unit": ""
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "pitch",
        "expression": "24",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "rows",
        "expression": "2",
        "unit": ""
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "row_pitch",
        "expression": "28",
        "unit": "mm"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 120,
        "width": 80,
        "height": 4,
        "corner": [
          -60.0,
          -40.0,
          0
        ],
        "body_name": "RectangularPattern"
      }
    },
    {
      "command": "model.faces",
      "params": {
        "body": "RectangularPattern"
      },
      "bind": {
        "$face_point_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "point"
        },
        "$face_index_1": {
          "field": "faces",
          "where": {
            "plane_normal": [
              0,
              0,
              1
            ]
          },
          "max": "area",
          "select": "index"
        }
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "plane": {
          "face": "$face_point_1",
          "body": "RectangularPattern",
          "index": "$face_index_1"
        },
        "project_edges": false,
        "name": "Slot"
      }
    },
    {
      "command": "sketch.slot.center_to_center",
      "params": {
        "p0": [
          -5.0,
          0.0
        ],
        "p1": [
          5.0,
          0.0
        ],
        "width": 6
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "operation": "cut",
        "targets": [
          "RectangularPattern"
        ],
        "name": "Slot",
        "distance": 4,
        "direction": "negative"
      }
    },
    {
      "command": "solid.pattern.rectangular",
      "params": {
        "features": [
          "Slot"
        ],
        "dir1": [
          1.0,
          0.0,
          0.0
        ],
        "count1": "columns",
        "spacing1": "pitch",
        "alignment": "right",
        "reversed": false,
        "dir2": [
          0.0,
          1.0,
          0.0
        ],
        "count2": "rows",
        "spacing2": "row_pitch",
        "alignment2": "right",
        "reversed2": false
      }
    }
  ]
}
