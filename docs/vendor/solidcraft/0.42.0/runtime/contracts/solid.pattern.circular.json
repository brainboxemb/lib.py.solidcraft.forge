{
  "id": "solid.pattern.circular",
  "input": {
    "$defs": {
      "AngleExpr": {
        "anyOf": [
          {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": -1000000000.0,
            "type": "number"
          },
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          }
        ],
        "description": "An angle: a number of degrees, or an expression such as \"30 deg\" or \"a / 2\"."
      },
      "LengthExpr": {
        "anyOf": [
          {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": -1000000000.0,
            "type": "number"
          },
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          }
        ],
        "description": "A length: a number in the design's length unit, or an expression such as \"w / 2\" or \"30 mm\"."
      },
      "NameList": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          }
        ],
        "description": "A name, or a list of names (at most 10000)."
      },
      "NumberExpr": {
        "anyOf": [
          {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": -1000000000.0,
            "type": "number"
          },
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          }
        ],
        "description": "A number with no unit, or an expression such as \"k / 2\"."
      },
      "PatternAxis": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "edge"
                  ]
                },
                {
                  "required": [
                    "face"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "edge",
                        "face"
                      ]
                    }
                  },
                  "required": [
                    "type"
                  ]
                }
              ]
            },
            "properties": {
              "dir": {
                "$ref": "#/$defs/Point3"
              },
              "origin": {
                "$ref": "#/$defs/PointExpr3"
              }
            },
            "required": [
              "dir"
            ],
            "type": "object"
          },
          {
            "not": {
              "required": [
                "type"
              ]
            },
            "properties": {
              "face": {
                "$ref": "#/$defs/Point3"
              }
            },
            "required": [
              "face"
            ],
            "type": "object"
          },
          {
            "not": {
              "required": [
                "type"
              ]
            },
            "properties": {
              "edge": {
                "$ref": "#/$defs/Point3"
              }
            },
            "required": [
              "edge"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "edge",
                  "face"
                ]
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ],
        "description": "An axis: X, Y or Z (any case), a construction axis's name (the plane follows it as it moves), {\"origin\"?: [x, y, z] in mm (default: the origin; fixed), \"dir\": [x, y, z] that isn't zero}, or a straight or circular edge, or a cylinder, cone or torus face, of a body ({\"edge\": [x, y, z]} or {\"face\": [x, y, z]}, a point on it, or as saved: {\"type\": \"edge\" or \"face\", \"at\", \"name\"?}), whose axis the plane follows as the model changes."
      },
      "Point3": {
        "anyOf": [
          {
            "items": {
              "exclusiveMaximum": 1000000000.0,
              "exclusiveMinimum": -1000000000.0,
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "properties": {
              "x": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "y": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "z": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          }
        ],
        "description": "A point in mm: [x, y, z] or {\"x\", \"y\", \"z\"}."
      },
      "PointExpr3": {
        "anyOf": [
          {
            "items": {
              "$ref": "#/$defs/LengthExpr"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "properties": {
              "x": {
                "$ref": "#/$defs/LengthExpr"
              },
              "y": {
                "$ref": "#/$defs/LengthExpr"
              },
              "z": {
                "$ref": "#/$defs/LengthExpr"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          }
        ],
        "description": "A point: [x, y, z] or {\"x\", \"y\", \"z\"}, each a number in mm or a length expression."
      },
      "StringList": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          }
        ],
        "description": "A name, or a list of names."
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Copy features, bodies or components evenly round an axis. Give one of `features`, `bodies` or\n`components`. One undo step.",
    "properties": {
      "alignment": {
        "description": "Where the original sits in the pattern. Default: right, the original stays fixed.",
        "enum": [
          "left",
          "center",
          "right"
        ],
        "type": "string"
      },
      "angle": {
        "anyOf": [
          {
            "$ref": "#/$defs/AngleExpr"
          },
          {
            "type": "null"
          }
        ],
        "description": "The angle the copies span. Default: 360 deg; a partial arc includes both ends."
      },
      "axis": {
        "$ref": "#/$defs/PatternAxis",
        "description": "The axis to turn about. The coordinates of `{origin, dir}`'s origin may also be length\nexpressions, which the pattern follows."
      },
      "bodies": {
        "anyOf": [
          {
            "$ref": "#/$defs/NameList"
          },
          {
            "type": "null"
          }
        ],
        "description": "The bodies to copy, by name. Used when `components` is left out or empty."
      },
      "body_name": {
        "default": null,
        "description": "The new body's name.",
        "type": [
          "string",
          "null"
        ]
      },
      "body_names": {
        "anyOf": [
          {
            "$ref": "#/$defs/StringList"
          },
          {
            "type": "null"
          }
        ],
        "description": "Names for the new bodies, in order."
      },
      "components": {
        "anyOf": [
          {
            "$ref": "#/$defs/NameList"
          },
          {
            "type": "null"
          }
        ],
        "description": "The components to place more of, by id or name. The reply then lists the new occurrences."
      },
      "count": {
        "$ref": "#/$defs/NumberExpr",
        "description": "How many, the original included: a whole number or an expression that gives one."
      },
      "features": {
        "anyOf": [
          {
            "$ref": "#/$defs/NameList"
          },
          {
            "type": "null"
          }
        ],
        "description": "The features to copy, by name. Used when `bodies` and `components` are left out or empty."
      },
      "name": {
        "default": null,
        "description": "The feature's name in the timeline.",
        "type": [
          "string",
          "null"
        ]
      },
      "participants": {
        "anyOf": [
          {
            "$ref": "#/$defs/StringList"
          },
          {
            "type": "null"
          }
        ],
        "description": "The bodies taking part, each an existing body or `*`; what that changes depends on the\nfeature."
      },
      "reversed": {
        "description": "Flip the pattern's direction; for an even count centred, selects the extra side.",
        "type": "boolean"
      }
    },
    "required": [
      "axis",
      "count"
    ],
    "title": "PatternCircularParams",
    "type": "object"
  },
  "label": "Circular Pattern",
  "output": {
    "$defs": {
      "FeatureNotice": {
        "description": "Something a feature's result tells the user without stopping them, with an action to take.",
        "properties": {
          "action": {
            "$ref": "#/$defs/NoticeAction",
            "description": "The command that changes the feature as the notice offers."
          },
          "contact": {
            "description": "How the bodies split off touched the others: `along_edge`, `at_point` or `touching` (along\na line or at a point their boundaries don't hold).",
            "type": "string"
          },
          "message": {
            "description": "The text to show.",
            "type": "string"
          }
        },
        "required": [
          "message",
          "contact",
          "action"
        ],
        "type": "object"
      },
      "FeatureResult": {
        "description": "What a feature command returns.",
        "properties": {
          "bodies": {
            "description": "Every body after the feature.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "changed_bodies": {
            "description": "Bodies that were there before and now have other geometry.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "created_bodies": {
            "description": "The bodies the feature made.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "feature": {
            "description": "The new feature's id.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "ms": {
            "description": "How long the feature took to evaluate, in milliseconds.",
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "name": {
            "description": "The new feature's name.",
            "type": "string"
          },
          "notice": {
            "anyOf": [
              {
                "$ref": "#/$defs/FeatureNotice"
              },
              {
                "type": "null"
              }
            ],
            "description": "A join that split pieces into bodies of their own because they touch the others only along\nan edge or at a point (its `touching: separate`): what to tell the user, and the edit that\nmakes them one body instead. Left out otherwise, also when the join kept pieces that touch\nnothing in one body."
          },
          "param_warnings": {
            "description": "In the warn parameter-check mode: what the call's parameters got wrong.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "removed_bodies": {
            "description": "Bodies that are gone.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "warning": {
            "description": "A warning from the evaluation (a Boolean that needed a retry, a reference found again\nelsewhere), or `null`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "feature",
          "name",
          "bodies",
          "created_bodies",
          "changed_bodies",
          "removed_bodies",
          "warning",
          "ms"
        ],
        "type": "object"
      },
      "NoticeAction": {
        "description": "A command a notice offers to run.",
        "properties": {
          "command": {
            "description": "The command's id.",
            "type": "string"
          },
          "label": {
            "description": "The action's label.",
            "type": "string"
          },
          "params": {
            "description": "Its parameters."
          }
        },
        "required": [
          "label",
          "command",
          "params"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "$ref": "#/$defs/FeatureResult",
        "description": "With `features` or `bodies`."
      },
      {
        "description": "With `components`.",
        "properties": {
          "occurrences": {
            "description": "The new occurrences' ids.",
            "items": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "type": "array"
          },
          "param_warnings": {
            "description": "In the warn parameter-check mode: what the call's parameters got wrong.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "occurrences"
        ],
        "type": "object"
      }
    ],
    "description": "What `solid.pattern.circular` returns.",
    "title": "PatternCircularResult"
  },
  "params": "features: [names] | bodies: [names] | components: [names]; axis: X|Y|Z | construction axis name (followed when edited) | {origin, dir} (origin coordinates may be length expressions; the pattern follows them) | {edge|face: [x,y,z]} (a straight or circular edge, or a cylinder, cone or torus face: about its axis, followed as the model changes); count; angle? (default 360 deg; partial arcs include both ends); alignment?: left|center|right (default right; original stays fixed); reversed?: bool (Flip; selects the extra side for even centered counts)"
}
