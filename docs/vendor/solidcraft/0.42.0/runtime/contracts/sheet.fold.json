{
  "id": "sheet.fold",
  "input": {
    "$defs": {
      "AngleExpr": {
        "anyOf": [
          {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": -1000000000.0,
            "type": "number"
          },
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          }
        ],
        "description": "An angle: a number of degrees, or an expression such as \"30 deg\" or \"a / 2\"."
      },
      "FixedPoint": {
        "anyOf": [
          {
            "items": {
              "exclusiveMaximum": 1000000000.0,
              "exclusiveMinimum": -1000000000.0,
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "properties": {
              "x": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "y": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "z": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          }
        ],
        "description": "A point in mm: [x, y, z] or {\"x\", \"y\", \"z\"}."
      },
      "FoldPoints": {
        "description": "The fold line's two ends, in mm.",
        "items": {
          "$ref": "#/$defs/Point3"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "FoldPosition": {
        "description": "centerline, start, end or mould (or mold), in any case.",
        "pattern": "^([Cc][Ee][Nn][Tt][Ee][Rr][Ll][Ii][Nn][Ee]|[Ss][Tt][Aa][Rr][Tt]|[Ee][Nn][Dd]|[Mm][Oo][Uu][Ll][Dd]|[Mm][Oo][Ll][Dd])$",
        "type": "string"
      },
      "LengthExpr": {
        "anyOf": [
          {
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": -1000000000.0,
            "type": "number"
          },
          {
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028-\\u2029\\u202f\\u205f\\u3000]",
            "type": "string"
          }
        ],
        "description": "A length: a number in the design's length unit, or an expression such as \"w / 2\" or \"30 mm\"."
      },
      "Point3": {
        "anyOf": [
          {
            "items": {
              "exclusiveMaximum": 1000000000.0,
              "exclusiveMinimum": -1000000000.0,
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          {
            "properties": {
              "x": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "y": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              },
              "z": {
                "exclusiveMaximum": 1000000000.0,
                "exclusiveMinimum": -1000000000.0,
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ],
            "type": "object"
          }
        ],
        "description": "A point in mm: [x, y, z] or {\"x\", \"y\", \"z\"}."
      },
      "SketchRef": {
        "description": "A sketch's feature id (a number) or its name.",
        "type": [
          "number",
          "string"
        ]
      },
      "StringList": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "maxItems": 10000,
            "type": "array"
          }
        ],
        "description": "A name, or a list of names."
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Fold a sheet along a line on its top or bottom face: a sketch line (followed when the sketch\nchanges) or two points. The bend zone comes out of the sheet, so the flat pattern keeps its\nsize. `participants` changes nothing.",
    "properties": {
      "angle": {
        "anyOf": [
          {
            "$ref": "#/$defs/AngleExpr"
          },
          {
            "type": "null"
          }
        ],
        "description": "The bend angle. Default: 90 deg."
      },
      "body": {
        "default": null,
        "description": "The sheet metal body. Default: the sheet with an edge nearest the line's middle.",
        "type": [
          "string",
          "null"
        ]
      },
      "body_name": {
        "default": null,
        "description": "The new body's name.",
        "type": [
          "string",
          "null"
        ]
      },
      "body_names": {
        "anyOf": [
          {
            "$ref": "#/$defs/StringList"
          },
          {
            "type": "null"
          }
        ],
        "description": "Names for the new bodies, in order."
      },
      "curve": {
        "default": null,
        "description": "The fold line: a line of `sketch`, by id. Required unless `points` is given; ignored then.",
        "type": [
          "string",
          "null"
        ]
      },
      "fixed": {
        "$ref": "#/$defs/FixedPoint",
        "description": "A point on the side that stays, on the sheet. Default: the larger side (on a flange, the\nside toward its own bend)."
      },
      "flip": {
        "default": null,
        "description": "Fold the other way. Default: false.",
        "type": [
          "boolean",
          "null"
        ]
      },
      "name": {
        "default": null,
        "description": "The feature's name in the timeline.",
        "type": [
          "string",
          "null"
        ]
      },
      "participants": {
        "anyOf": [
          {
            "$ref": "#/$defs/StringList"
          },
          {
            "type": "null"
          }
        ],
        "description": "The bodies taking part, each an existing body or `*`; what that changes depends on the\nfeature."
      },
      "points": {
        "$ref": "#/$defs/FoldPoints",
        "description": "The fold line's two ends, instead of `sketch` and `curve`."
      },
      "position": {
        "anyOf": [
          {
            "$ref": "#/$defs/FoldPosition"
          },
          {
            "type": "null"
          }
        ],
        "description": "Where the line sits in the bend zone: its centre (centerline), its start or end, from the\nside that stays, or the mould line (mould: where the outer faces meet). Default:\ncenterline."
      },
      "radius": {
        "anyOf": [
          {
            "$ref": "#/$defs/LengthExpr"
          },
          {
            "type": "null"
          }
        ],
        "description": "The inner bend radius. Default: the sheet's rule's."
      },
      "sketch": {
        "$ref": "#/$defs/SketchRef",
        "description": "The sketch holding the fold line, by id or name. Required unless `points` is given;\nignored then."
      }
    },
    "title": "FoldParams",
    "type": "object"
  },
  "label": "Fold",
  "output": {
    "$defs": {
      "FeatureNotice": {
        "description": "Something a feature's result tells the user without stopping them, with an action to take.",
        "properties": {
          "action": {
            "$ref": "#/$defs/NoticeAction",
            "description": "The command that changes the feature as the notice offers."
          },
          "contact": {
            "description": "How the bodies split off touched the others: `along_edge`, `at_point` or `touching` (along\na line or at a point their boundaries don't hold).",
            "type": "string"
          },
          "message": {
            "description": "The text to show.",
            "type": "string"
          }
        },
        "required": [
          "message",
          "contact",
          "action"
        ],
        "type": "object"
      },
      "NoticeAction": {
        "description": "A command a notice offers to run.",
        "properties": {
          "command": {
            "description": "The command's id.",
            "type": "string"
          },
          "label": {
            "description": "The action's label.",
            "type": "string"
          },
          "params": {
            "description": "Its parameters."
          }
        },
        "required": [
          "label",
          "command",
          "params"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "What a feature command returns.",
    "properties": {
      "bodies": {
        "description": "Every body after the feature.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "changed_bodies": {
        "description": "Bodies that were there before and now have other geometry.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "created_bodies": {
        "description": "The bodies the feature made.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "feature": {
        "description": "The new feature's id.",
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "ms": {
        "description": "How long the feature took to evaluate, in milliseconds.",
        "format": "double",
        "type": [
          "number",
          "null"
        ]
      },
      "name": {
        "description": "The new feature's name.",
        "type": "string"
      },
      "notice": {
        "anyOf": [
          {
            "$ref": "#/$defs/FeatureNotice"
          },
          {
            "type": "null"
          }
        ],
        "description": "A join that split pieces into bodies of their own because they touch the others only along\nan edge or at a point (its `touching: separate`): what to tell the user, and the edit that\nmakes them one body instead. Left out otherwise, also when the join kept pieces that touch\nnothing in one body."
      },
      "param_warnings": {
        "description": "In the warn parameter-check mode: what the call's parameters got wrong.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "removed_bodies": {
        "description": "Bodies that are gone.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "warning": {
        "description": "A warning from the evaluation (a Boolean that needed a retry, a reference found again\nelsewhere), or `null`.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "feature",
      "name",
      "bodies",
      "created_bodies",
      "changed_bodies",
      "removed_bodies",
      "warning",
      "ms"
    ],
    "title": "FeatureResult",
    "type": "object"
  },
  "params": "line: sketch + curve (a sketch line on the sheet's base face; followed when the sketch changes) or points: [[x,y,z], [x,y,z]]; angle? (default 90 deg); radius? (default: rule); position?: centerline|start|end|mould (where the line sits in the bend, default centerline); fixed?: [x,y,z] on the side that stays (default: the larger side); flip? (fold the other way); body?"
}
