{
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "expression": "40",
        "name": "board_width",
        "unit": "mm"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "expression": "20",
        "name": "board_height",
        "unit": "mm"
      }
    },
    {
      "bind": {
        "$board": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Board"
      }
    },
    {
      "command": "sketch.create",
      "params": {
        "name": "d1_Board__Profile",
        "plane": "XZ"
      }
    },
    {
      "command": "sketch.line",
      "params": {
        "closed": true,
        "ids": [
          "lower_left",
          "lower_right",
          "upper_right",
          "upper_left"
        ],
        "points": [
          [
            "-(board_width / 2)",
            0
          ],
          [
            "board_width / 2",
            0
          ],
          [
            "board_width / 2",
            "-(board_height)"
          ],
          [
            "-(board_width / 2)",
            "-(board_height)"
          ]
        ]
      }
    },
    {
      "command": "sketch.finish",
      "params": {}
    },
    {
      "command": "solid.extrude",
      "params": {
        "body_name": "Board",
        "direction": "positive",
        "distance": 12.0
      }
    },
    {
      "command": "material.create",
      "params": {
        "density_g_cm3": 0.55,
        "name": "test board"
      }
    },
    {
      "command": "material.assign",
      "params": {
        "bodies": [
          "Board"
        ],
        "material": "test board"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$rightmarker": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": false,
        "name": "RightMarker"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "RightMarker",
        "center": [
          0,
          0,
          0
        ],
        "height": 10,
        "length": 10,
        "width": 10
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$leftmarker": "occurrence"
      },
