            20.0
          ],
          "edge": [
            20.0,
            0.0,
            10.0
          ],
          "occurrence": "$board",
          "on": [
            0.0,
            0.0,
            10.0
          ]
        },
        "b": {
          "occurrence": "$rightmarker",
          "point": [
            20.0,
            0.0,
            20.0
          ],
          "x": [
            -1.0,
