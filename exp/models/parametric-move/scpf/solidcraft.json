{
  "commands": [
    {
      "bind": {
        "$block_occurrence_1": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Block"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Block",
        "center": [
          0,
          0,
          0
        ],
        "height": 10,
        "length": 20,
        "width": 20
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$block_occurrence_2": "occurrence"
      },
      "command": "occurrence.copy",
      "params": {
        "component": "Block"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "expression": "40 mm",
        "name": "offset"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block_occurrence_2",
        "translate": [
          "offset",
          0,
          0
        ]
      }
    }
  ],
  "format": "scpf-replay",
  "version": 2
}
