{
  "commands": [
    {
      "command": "parameters.add",
      "params": {
        "expression": "40",
        "name": "base_width",
        "unit": "mm"
      }
    },
    {
      "bind": {
        "$base": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Base"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Base",
        "corner": [
          "-base_width / 2",
          -15.0,
          0
        ],
        "height": 10,
        "length": "base_width",
        "width": 30
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$block": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": false,
        "name": "Block"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Block",
        "corner": [
          -10.0,
          -10.0,
          0
        ],
        "height": 10,
        "length": 20,
        "width": 20
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block",
        "translate": [
          "((-(base_width / 2)) + (base_width)) - -10 mm",
          0,
          0.0
        ]
      }
    },
    {
      "command": "joint.create",
      "params": {
        "a": {
          "face": [
            20.0,
            0.0,
            5.0
          ],
          "occurrence": "$base"
        },
        "b": {
          "face": [
            20.0,
            0.0,
            5.0
          ],
          "occurrence": "$block"
        },
        "name": "Attach Block to Base",
        "type": "rigid"
      }
    },
    {
      "command": "browser.visibility",
      "params": {
        "folder": "joints",
        "visible": false
      }
    }
  ],
  "format": "scpf-replay",
  "version": 2
}
