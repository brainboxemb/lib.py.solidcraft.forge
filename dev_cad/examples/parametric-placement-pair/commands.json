{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "Block",
        "grounded": false
      },
      "bind": {
        "$block_occurrence_1": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 20,
        "width": 20,
        "height": 10,
        "center": [
          0,
          0,
          0
        ],
        "body_name": "Block"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.copy",
      "params": {
        "component": "Block"
      },
      "bind": {
        "$block_occurrence_2": "occurrence"
      }
    },
    {
      "command": "parameters.add",
      "params": {
        "name": "spacing",
        "expression": "80 mm"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block_occurrence_1",
        "translate": [
          "-(spacing / 2)",
          0,
          0
        ]
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$block_occurrence_2",
        "translate": [
          "spacing / 2",
          0,
          0
        ]
      }
    }
  ]
}
