{
  "format": "scpf-replay",
  "version": 2,
  "commands": [
    {
      "command": "component.create",
      "params": {
        "name": "Base",
        "grounded": true
      },
      "bind": {
        "$base": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 60.0,
        "width": 60.0,
        "height": 10.0,
        "corner": [
          -30.0,
          -30.0,
          0
        ],
        "body_name": "Base"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "component.create",
      "params": {
        "name": "Arm",
        "grounded": false
      },
      "bind": {
        "$arm": "occurrence"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "length": 30.0,
        "width": 10.0,
        "height": 6.0,
        "corner": [
          -15.0,
          -5.0,
          0
        ],
        "body_name": "Arm"
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "occurrence": "$arm",
        "translate": [
          0,
          0,
          10.0
        ]
      }
    },
    {
      "command": "joint.create",
      "params": {
        "type": "rigid",
        "name": "Attach Arm to Base",
        "a": {
          "face": [
            0.0,
            0.0,
            10.0
          ],
          "occurrence": "$base"
        },
        "b": {
          "face": [
            0.0,
            0.0,
            10.0
          ],
          "occurrence": "$arm"
        },
        "angle": 90.0
      }
    },
    {
      "command": "browser.visibility",
      "params": {
        "folder": "joints",
        "visible": false
      }
    }
  ]
}
