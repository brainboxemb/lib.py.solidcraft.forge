{
  "commands": [
    {
      "bind": {
        "$panel_occurrence_1": "occurrence"
      },
      "command": "component.create",
      "params": {
        "grounded": true,
        "name": "Panel"
      }
    },
    {
      "command": "solid.box",
      "params": {
        "body_name": "Panel",
        "center": [
          0,
          0,
          0
        ],
        "height": 4,
        "length": 20,
        "width": 10
      }
    },
    {
      "command": "component.activate",
      "params": {
        "component": "root"
      }
    },
    {
      "bind": {
        "$panel_occurrence_2": "occurrence"
      },
      "command": "occurrence.copy",
      "params": {
        "component": "Panel"
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "angle": "90 deg",
        "axis": [
          0.0,
          0.0,
          1.0
        ],
        "move_grounded": true,
        "occurrence": "$panel_occurrence_1",
        "translate": [
          -40,
          0,
          0
        ]
      }
    },
    {
      "command": "occurrence.move",
      "params": {
        "angle": "90 deg",
        "axis": [
          0.0,
          0.0,
          1.0
        ],
        "occurrence": "$panel_occurrence_2",
        "translate": [
          40,
          0,
          0
        ]
      }
    }
  ],
  "format": "scpf-replay",
  "version": 2
}
